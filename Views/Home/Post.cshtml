@model Post
@{
    ViewData["Title"] = Model.Title;
}
<article class="post-card single" data-post-id="@Model.Id">
    <div class="post-head">
        <img class="avatar big" src="@Model.AvatarUrl" alt="avatar" onerror="this.onerror=null;this.src='/avatars/default.svg';" />
        <div>
            <h1>@Model.Title</h1>
            <div class="meta">#@Model.Id · @Model.DisplayName (@Model.Username) · @Model.CreatedAt</div>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        <img class="post-image" src="@Model.ImageUrl" alt="post image" />
    }
    <p>@Model.Body</p>
</article>
<a href="/">назад</a>

@section Scripts {
<script>
(() => {
    const card = document.querySelector('[data-post-id]');
    if (!card) return;

    const id = card.getAttribute('data-post-id');
    const body = new URLSearchParams({ id });

    fetch('/api/posts/get', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Board-Client': 'legacy-post-card'
        },
        body: body.toString(),
        credentials: 'same-origin',
        cache: 'no-store'
    }).then(r => r.ok ? r.json() : null)
      .then(data => {
          window.__postShadow = data;
      })
      .catch(() => {});
})();
</script>
}
